{
  "name": "ikun",
  "version": "8.8.8",
  "description": "Local multi-profile fingerprint browser with a local automation API. Clean-room implementation for learning/research. No vendor backend required.",
  "main": "electron/main.js",
  "type": "commonjs",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "electron": "electron .",
    "dist:win": "electron-builder --win --x64 -p never",
    "pack:mac-arm64": "electron-packager . IKUN --icon=electron/assets/icon.icns --platform=darwin --arch=arm64 --out=dist --overwrite --prune --ignore=\"^/(test|.browsers|dist|.*.zip$)\"",
    "test": "node --test --test-concurrency=1 test/security.test.js test/network.test.js test/runtime.test.js test/downloads.js test/environments.test.js",
    "test:desktop": "node --test test/desktop.test.js",
    "test:icons": "node --test test/profile-icons.test.js",
    "smoke": "node test/smoke.js"
  },
  "build": {
    "appId": "local.ikun.browser",
    "productName": "ikun",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "electron/assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "icon": "electron/assets/icon.icns",
      "target": "dmg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ikun",
      "artifactName": "${productName} 正式版 安装包.${ext}"
    },
    "portable": {
      "artifactName": "${productName} 绿色免安装单文件.${ext}"
    }
  },
  "dependencies": {
    "@koa/router": "^12.0.1",
    "koa": "^2.15.3",
    "koa-bodyparser": "^4.4.1",
    "playwright": "1.64.1"
  },
  "devDependencies": {
    "electron": "44.10.0",
    "electron-builder": "^24.13.3",
    "electron-packager": "npm:@electron/packager@20.3.0"
  }
}
